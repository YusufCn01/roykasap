<UserControl x:Class="KasapOtomasyon.WPF.Views.ProductManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BrushBackground}"
             Foreground="{StaticResource BrushTextPrimary}">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:WeightFormatConverter x:Key="WeightConv"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Product List -->
        <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc products.listTitle}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Products.Count, StringFormat='({0})'}" Foreground="{StaticResource BrushTextMuted}" 
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" Command="{Binding NewProductCommand}" 
                            Content="{loc:Loc products.new}" Style="{StaticResource FluentPrimaryButton}" Padding="14,6"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                          Style="{StaticResource FluentDataGrid}" BorderThickness="0"
                          SelectionChanged="DataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc products.code}" Binding="{Binding Code}" Width="90" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="{loc:Loc products.name}" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="{loc:Loc products.category}" Binding="{Binding CategoryName}" Width="1.2*"/>
                        <DataGridTextColumn Header="{loc:Loc products.type}" Binding="{Binding ProductType}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc products.salePrice}" Binding="{Binding SalePrice, Converter={StaticResource CurrencyConv}}" Width="1.2*" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="{loc:Loc products.stock}" Binding="{Binding CurrentStock, StringFormat='{}{0:0.00}'}" Width="1*"/>
                        <DataGridTextColumn Header="{loc:Loc products.shelfLifeDays}" Binding="{Binding ShelfLifeDays}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Product Editor & Barcode Designer Preview -->
        <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc products.editorTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

                    <TextBlock Text="{loc:Loc products.name}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,12" Height="36"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc products.category}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding EditCategory}"
                                      DisplayMemberPath="Name" Background="{StaticResource BrushSurface}" Foreground="#000000" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc products.unit}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding EditUnit}"
                                      DisplayMemberPath="Name" Background="{StaticResource BrushSurface}" Foreground="#000000" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:Loc products.salePrice}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSalePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:Loc products.costPrice}" Foreground="{StaticResource BrushTextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36"/>
                        </StackPanel>
                    </Grid>

                    <!-- Barcode Section -->
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                            CornerRadius="8" Padding="14" Margin="0,4,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{loc:Loc products.barcodePluSettings}" FontWeight="Bold" FontSize="13"/>
                                <Button HorizontalAlignment="Right" Command="{Binding GenerateNewBarcodeCommand}" 
                                        Content="{loc:Loc products.generateBarcode}" Style="{StaticResource FluentSecondaryButton}" Padding="8,3" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{loc:Loc products.pluCode}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding EditPluCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc products.barcode}" Foreground="{StaticResource BrushTextSecondary}" FontSize="11" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Label Designer Preview Card -->
                            <Border Background="#FFFFFF" CornerRadius="6" Padding="12" Margin="0,6,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding EditName}" FontWeight="Bold" FontSize="12" Foreground="#000000" HorizontalAlignment="Center"/>
                                    <TextBlock Text="|| | ||| | |||| || |||| | |" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center" Margin="0,2"/>
                                    <TextBlock Text="{Binding GeneratedPreviewBarcode}" FontSize="11" Foreground="#000000" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <CheckBox Content="{loc:Loc products.quickButton}" IsChecked="{Binding EditIsQuickButton}" Margin="0,0,0,16"/>

                    <!-- Save & Delete Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Command="{Binding DeleteProductCommand}" 
                                Content="{loc:Loc products.deleteBtn}" Style="{StaticResource FluentSecondaryButton}" Foreground="{StaticResource BrushDanger}" 
                                Padding="16,10" Margin="0,0,10,0"/>

                        <Button Grid.Column="1" Command="{Binding SaveProductCommand}" 
                                Content="{loc:Loc products.saveBtn}" Style="{StaticResource FluentPrimaryButton}" Height="42"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" 
                               FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
