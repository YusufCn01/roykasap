                                            <TextBlock Text="{Binding CurrentPassportDocument.Gender}" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock Text="CANLI KANTAR KG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.LiveWeightKg, Converter={StaticResource WeightConv}}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="ÜRETİCİ / BESİCİ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.ProducerName}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="MENŞE KONUMU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.FarmOrigin}" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="SEVK İRSALİYESİ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.WaybillNumber}" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="3">
                                            <TextBlock Text="GİRİŞ TARİHİ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.ArrivalDate, StringFormat='{}{0:dd.MM.yyyy}'}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 2. Veteriner Muayene -->
                                <TextBlock Text="2. 🩺 VETERİNER HEKİM ANTEMORTEM SAĞLIK RAPORU" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="6"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="VETERİNER HEKİM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.VetDoctorName}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Text="RAPOR NO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.VetReportNumber}" FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="VÜCUT SICAKLIĞI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.VetBodyTemperature, StringFormat='{}{0:N1} °C'}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock Text="KESİM İZİN DURUMU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.VetStatus}" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4">
                                            <TextBlock Text="KLİNİK TANI / BULGULAR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.VetDiagnosis}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 3. Kesimhane, Karkas & SEUROP -->
                                <TextBlock Text="3. 🔪 KESİMHANE, KARKAS VE SEUROP KALİTE DERECELENDİRMESİ" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="KARKAS NO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.CarcassNumber}" FontSize="14" FontWeight="Bold" Foreground="#B45309"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Text="SOĞUK KARKAS KG" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.ColdCarcassWeightKg, Converter={StaticResource WeightConv}}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="KARKAS RANDIMANI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.CarcassYieldPercentage, StringFormat='{}% {0:N2}'}" FontSize="14" FontWeight="Bold" Foreground="#16A34A"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0" Grid.Column="3">
                                            <TextBlock Text="SEUROP SINIFI" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.ConformationClass, StringFormat='Sınıf {0}'}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="YAĞLILIK SKORU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.FatCoverScore, StringFormat='{}{0} / 5'}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="MERMERLEŞME (BMS)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.MarblingScore, StringFormat='BMS {0}'}" FontSize="12" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="24h pH DEĞERİ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.PostMortemPh24, StringFormat='{}{0:N2} pH'}" FontSize="12" FontWeight="Bold" Foreground="#15803D"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="3">
                                            <TextBlock Text="DEPO / KANCA NO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding CurrentPassportDocument.HookRailNumber}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 4. Parçalama & Et Çıktıları -->
                                <TextBlock Text="4. 🥩 KARKAS PARÇALAMA VE ANATOMİK ET ÇIKTILARI DÖKÜMÜ" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,6"/>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="0">
                                    <DataGrid ItemsSource="{Binding CurrentPassportDocument.DeboningCuts}" Style="{StaticResource FluentDataGrid}" BorderThickness="0" MaxHeight="220">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Anatomik Bölge" Binding="{Binding AnatomicalRegion}" FontWeight="Bold" Width="1.5*"/>
                                            <DataGridTextColumn Header="Çıkan Et Parçası" Binding="{Binding CutName}" FontWeight="Bold" Width="2*"/>
                                            <DataGridTextColumn Header="Ağırlık (Kg)" Binding="{Binding WeightKg, Converter={StaticResource WeightConv}}" FontWeight="Bold" Foreground="#16A34A" Width="1.1*"/>
                                            <DataGridTextColumn Header="Randıman" Binding="{Binding YieldPercentage, StringFormat='{}% {0:N1}'}" Width="1*"/>
                                            <DataGridTextColumn Header="Kalite Sınıfı" Binding="{Binding QualityGrade}" Width="1.2*"/>
                                            <DataGridTextColumn Header="Birim Maliyet" Binding="{Binding UnitCostEstimated, Converter={StaticResource CurrencyConv}}" Width="1.1*"/>
                                            <DataGridTextColumn Header="Toplam Değer" Binding="{Binding TotalCutValue, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" Foreground="#B45309" Width="1.3*"/>
                                            <DataGridTextColumn Header="Lot / Parti No" Binding="{Binding LotNumber}" FontSize="11" Width="1.4*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Bottom Action Buttons -->
                    <Grid Grid.Row="2">
                        <Button HorizontalAlignment="Left" Command="{Binding ClosePassportDialogCommand}" Content="Kapat" Style="{StaticResource FluentSecondaryButton}" Height="44" Padding="22,0"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ExportAndPrintPassportPdfCommand}" CommandParameter="{Binding CurrentPassportDocument.EarTagNumber}" 
                                Content="🖨 RESMİ PDF ÇIKTISI AL / YAZDIR" Style="{StaticResource FluentPrimaryButton}" Height="44" Padding="28,0" FontWeight="Bold" Background="#DC2626"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- DIALOG 7: GERÇEK MALİYET & KÂRLILIK ANALİZİ (TRUE COST ROLLUP)             -->
        <!-- ========================================================================= -->
        <Grid Grid.RowSpan="2" Background="#60000000" Visibility="{Binding IsTrueCostDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="950" MaxHeight="850" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                    CornerRadius="16" Padding="26" Effect="{StaticResource EffectModalShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#15803D" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                <TextBlock Text="💰" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="GERÇEK MALİYET &amp; KÂRLILIK ANALİZİ (ACTIVITY-BASED COSTING)" FontSize="16" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock Text="Hayvan Alım, Nakil, Kesim, Soğutma ve Parçalama Giderleri ile Yan Ürün Kredileri Dağılımı" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Button HorizontalAlignment="Right" Command="{Binding CloseTrueCostDialogCommand}" 
                                Content="✕" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Top Metric Summary Cards -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="TOPLAM BRÜT MALİYET" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                                        <TextBlock Text="{Binding CurrentTrueCostRollup.TotalGrossCost, Converter={StaticResource CurrencyConv}}" FontSize="20" FontWeight="Black" Foreground="#DC2626" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1.5" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="YAN ÜRÜN KREDİLERİ (-)" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                        <TextBlock Text="{Binding CurrentTrueCostRollup.TotalByproductCredits, Converter={StaticResource CurrencyConv}}" FontSize="20" FontWeight="Black" Foreground="#15803D" Margin="0,4,0,0"/>
                                        <TextBlock Text="Deri + Sakatat + Yağ Geliri" FontSize="10" Foreground="#15803D"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="10" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="NET KARKAS KG MALİYETİ" FontSize="11" FontWeight="Bold" Foreground="#1E40AF"/>
                                        <TextBlock Text="{Binding CurrentTrueCostRollup.TrueCostPerCarcassKg, Converter={StaticResource CurrencyConv}}" FontSize="20" FontWeight="Black" Foreground="#2563EB" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding CurrentTrueCostRollup.ColdCarcassWeightKg, StringFormat='Soğuk Karkas: {0:N1} kg'}" FontSize="10" Foreground="#2563EB"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Cost Breakdown Table -->
                            <TextBlock Text="MALİYET KALEMLERİ DETAY TABLOSU (ABC METODU)" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="1. Canlı Hayvan Alım Maliyeti:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.AnimalPurchaseCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="2. Nakliye &amp; Lojistik Gideri:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.LivestockTransportCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3. Kesimhane İşçilik &amp; Hat Gideri:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.SlaughterLaborCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="4. Soğuk Hava Deposu Elektrik/Enerji:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.ColdStorageChillingEnergyCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="5. Kemiksizleştirme &amp; Parçalama İşçiliği:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.DeboningLaborCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="6. Genel Tesis ve Yönetim Payı:" FontSize="12" Margin="0,3"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CurrentTrueCostRollup.GeneralFacilityOverheadCost, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Button HorizontalAlignment="Right" Command="{Binding CloseTrueCostDialogCommand}" Content="Kapat" Style="{StaticResource FluentPrimaryButton}" Height="40" Padding="24,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- DIALOG 8: ACİL GERİ ÇAĞIRMA & BLOKE ETKİ ALANI (1-CLICK FOOD RECALL)        -->
        <!-- ========================================================================= -->
        <Grid Grid.RowSpan="2" Background="#60000000" Visibility="{Binding IsRecallDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="950" MaxHeight="850" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="#DC2626" BorderThickness="2.5"
                    CornerRadius="16" Padding="26" Effect="{StaticResource EffectModalShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#DC2626" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                <TextBlock Text="🚨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="1-TIK ACİL GIDA GERİ ÇAĞIRMA &amp; KARANTİNA KONTROLÜ (HACCP)" FontSize="16" FontWeight="Black" Foreground="#DC2626"/>
                                <TextBlock Text="Bakanlık / Kalite Alarmı: Tek bir küpe no ile geriye ve ileriye tüm lotları anında bloke eder." FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Button HorizontalAlignment="Right" Command="{Binding CloseRecallDialogCommand}" 
                                Content="✕" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Search & Trigger Box -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="10"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="KÖK NEDEN KÜPE / KARKAS NO" FontSize="11" FontWeight="Bold" Foreground="#991B1B"/>
                                        <TextBox Text="{Binding SearchTraceabilityQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource FluentTextBox}" Height="38" FontSize="13" FontWeight="Bold" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="0" Grid.Column="2" VerticalAlignment="Bottom"
                                            Command="{Binding TriggerEmergencyRecallCommand}"
                                            Content="🚨 1-TIKLA BLOKAJI BAŞLAT" Style="{StaticResource FluentPrimaryButton}" Height="38" Padding="20,0" FontWeight="Bold" Background="#DC2626"/>
                                </Grid>
                            </Border>

                            <!-- Recall Impact Result (If any) -->
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5" CornerRadius="10" Padding="16,12">
                                <StackPanel>
                                    <TextBlock Text="SON GERİ ÇAĞIRMA RAPORU &amp; BLOKAJ ETKİ ALANI" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="VAKA NO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding LastRecallResult.CaseNumber}" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="ETKİLENEN LOTLAR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding LastRecallResult.AffectedLotsCount, StringFormat='{}{0} Adet Lot'}" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="BLOKE EDİLEN ET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                                            <TextBlock Text="{Binding LastRecallResult.TotalRecalledWeightKg, Converter={StaticResource WeightConv}}" FontSize="13" FontWeight="Bold" Foreground="#DC2626"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Table of Blocked Items -->
                                    <DataGrid ItemsSource="{Binding LastRecallResult.AffectedItems}" Style="{StaticResource FluentDataGrid}" BorderThickness="0" MaxHeight="200">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Parti / Lot No" Binding="{Binding LotNumber}" FontWeight="Bold" Width="1.5*"/>
                                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="2*"/>
                                            <DataGridTextColumn Header="Bloke Ağırlık" Binding="{Binding QuantityKg, Converter={StaticResource WeightConv}}" FontWeight="Bold" Foreground="#DC2626" Width="1.2*"/>
                                            <DataGridTextColumn Header="Depo Konumu" Binding="{Binding WarehouseLocation}" Width="1.5*"/>
                                            <DataGridTextColumn Header="Müşteri Durumu" Binding="{Binding CustomerName}" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2">
                        <Button HorizontalAlignment="Right" Command="{Binding CloseRecallDialogCommand}" Content="Kapat" Style="{StaticResource FluentSecondaryButton}" Height="40" Padding="24,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
