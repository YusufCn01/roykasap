<Window x:Class="KasapOtomasyon.WPF.Views.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
        xmlns:views="clr-namespace:KasapOtomasyon.WPF.Views"
        xmlns:vm="clr-namespace:KasapOtomasyon.WPF.ViewModels"
        xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
        mc:Ignorable="d"
        Title="{loc:Loc shell.title}" 
        Icon="pack://application:,,,/Assets/roy_kasap_icon_512.png"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource BrushBgMain}"
        Foreground="{StaticResource BrushTextPrimary}"
        FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>

        <!-- View DataTemplates for Dedicated Full Pages -->
        <DataTemplate DataType="{x:Type vm:MainMenuViewModel}">
            <views:MainMenuPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductionViewModel}">
            <views:ProductionView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductManagementViewModel}">
            <views:ProductManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockViewModel}">
            <views:StockView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FinanceViewModel}">
            <views:FinanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomerAccountsViewModel}">
            <views:CustomerAccountsPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseInvoiceViewModel}">
            <views:PurchaseInvoiceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EInvoiceViewModel}">
            <views:EInvoicePage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserManagementViewModel}">
            <views:UserManagementPage/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LicenseViewModel}">
            <views:LicenseView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SlaughterhouseViewModel}">
            <views:SlaughterhouseManagementView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ShelfLifeReprocessingViewModel}">
            <views:ShelfLifeReprocessingView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/> <!-- TOP WINDOW TITLE BAR -->
            <RowDefinition Height="64"/> <!-- BREADCRUMB & HEADER BAR -->
            <RowDefinition Height="*"/>  <!-- DEDICATED FULL PAGE HOST -->
        </Grid.RowDefinitions>

        <!-- 1. TOP WINDOW TITLE BAR (Clean White Top Bar) -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Logo & Name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseDown="Logo_MouseDown">
                    <Image Source="pack://application:,,,/Assets/roy_kasap_logo.png" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{loc:Loc shell.title}" FontWeight="Bold" FontSize="13" Foreground="#BE123C" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Center: Multi-tenant Plant & Live Scale Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,3" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ActivePlantText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                    </Border>
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,3">
                        <TextBlock Text="{Binding ScaleLiveStatusText}" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                    </Border>
                </StackPanel>

                <!-- Top Right: Language Switcher, Shortcuts, Clock, Minimize, Fullscreen toggle, Close -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Language Switcher Buttons (TR, EN, PL) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Button Command="{Binding SwitchLanguageCommand}" CommandParameter="tr-TR" Content="🇹🇷 TR"
                                Style="{StaticResource FluentSecondaryButton}" Padding="6,3" FontSize="10.5" FontWeight="Bold" Margin="0,0,4,0"/>
                        <Button Command="{Binding SwitchLanguageCommand}" CommandParameter="en-GB" Content="🇬🇧 EN"
                                Style="{StaticResource FluentSecondaryButton}" Padding="6,3" FontSize="10.5" FontWeight="Bold" Margin="0,0,4,0"/>
                        <Button Command="{Binding SwitchLanguageCommand}" CommandParameter="pl-PL" Content="🇵🇱 PL"
                                Style="{StaticResource FluentSecondaryButton}" Padding="6,3" FontSize="10.5" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- F1 Shortcuts Sheet Button -->
                    <Button Command="{Binding ToggleShortcutsCommand}" Content="{loc:Loc shell.shortcuts}" 
                            Style="{StaticResource FluentSecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,10,0"/>

                    <!-- Digital Clock -->
                    <TextBlock Text="{Binding CurrentTimeString}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" 
                               VerticalAlignment="Center" Margin="0,0,14,0" FontFamily="Consolas"/>

                    <!-- Window State Controls -->
                    <Button Click="Minimize_Click" Content="—" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" Width="36" Height="32" FontSize="13" Cursor="Hand"/>
                    <Button Click="ToggleFullscreen_Click" Content="🗖" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" Width="36" Height="32" FontSize="13" Cursor="Hand"/>
                    <Button Click="Close_Click" Content="✕" Background="Transparent" Foreground="{StaticResource BrushDanger}" BorderThickness="0" Width="36" Height="32" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. BREADCRUMB & HEADER BAR -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1.5" Padding="20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Back to Main Menu Button + Page Title + Breadcrumbs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Back to Main Menu Button (Visible when NOT on Main Menu) -->
                    <Button Command="{Binding GoBackCommand}" 
                            Style="{StaticResource FluentPrimaryButton}" Height="38" Padding="14,0" Margin="0,0,16,0"
                            Visibility="{Binding NavService.IsOnMainMenu, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◀ " FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc shell.backToMainMenu}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <!-- Breadcrumbs -->
                        <ItemsControl ItemsSource="{Binding NavService.Breadcrumb}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"/>
                                        <TextBlock Text=" ➔ " FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="3,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Big Page Title -->
                        <TextBlock Text="{Binding NavService.CurrentPageTitle}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Notification Bell + User Profile + Logout -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Notification Bell with Badge -->
                    <Button Command="{Binding ToggleNotificationsCommand}" Style="{StaticResource FluentSecondaryButton}" 
                            Height="38" Padding="10,0" Margin="0,0,12,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔔 " FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Loc shell.notifications}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="#EF4444" CornerRadius="8" Padding="5,1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                    Visibility="{Binding NotificationCenter.UnreadCount, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding NotificationCenter.UnreadCount}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- User Profile Card -->
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" 
                            CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 " FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding CurrentUser.RoleName}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Safe Logout Button -->
                    <Button Command="{Binding LogoutCommand}" Content="{loc:Loc shell.logout}" 
                            Style="{StaticResource FluentSecondaryButton}" Foreground="{StaticResource BrushDanger}" 
                            Height="38" Padding="14,0" FontSize="12" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. DEDICATED FULL PAGE HOST (Zero margins, scales to fill 100% of the screen) -->
        <ContentControl Grid.Row="2" Content="{Binding CurrentViewModel}" Focusable="False"/>

        <!-- ==================================================== -->
        <!-- OVERLAYS & MODALS                                     -->
        <!-- ==================================================== -->

        <!-- A. KEYBOARD SHORTCUTS MODAL (F1) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#50000000" 
              Visibility="{Binding IsShortcutsModalOpen, Converter={StaticResource BoolToVis}}"
              MouseDown="ShortcutsModalOverlay_MouseDown">
            <Border Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                    CornerRadius="{StaticResource RadiusModal}" Padding="28" Effect="{StaticResource EffectModalShadow}">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="{loc:Loc shell.shortcutsModalTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        <Button HorizontalAlignment="Right" Command="{Binding ToggleShortcutsCommand}" 
                                Content="✕" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <UniformGrid Columns="2" Rows="6" Margin="0,0,0,16">
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.guide}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F1]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.pos}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F2]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.slaughter}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F3]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.stock}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F4]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.products}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F5]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.finance}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F6]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.customers}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F7]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.scale}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F8]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.reports}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F9]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.einvoice}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F10]" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.fullscreen}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[F11]" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/></Grid>
                        </Border>
                        <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="4">
                            <Grid><TextBlock Text="{loc:Loc shortcut.back}" Foreground="{StaticResource BrushTextSecondary}"/><TextBlock Text="[Ctrl+Home / Esc]" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Right"/></Grid>
                        </Border>
                    </UniformGrid>

                    <Button Command="{Binding ToggleShortcutsCommand}" Content="{loc:Loc common.close}" Style="{StaticResource FluentPrimaryButton}" Height="38"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- B. NOTIFICATION CENTER DRAWER (Slide in from Right - Clean White Panel) -->
        <Border Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" Width="400"
                Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1.5,0,0,0"
                Visibility="{Binding IsNotificationDrawerOpen, Converter={StaticResource BoolToVis}}"
                Effect="{StaticResource EffectModalShadow}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="{loc:Loc shell.notificationCenter}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <Button HorizontalAlignment="Right" Command="{Binding ToggleNotificationsCommand}" 
                            Content="✕" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" FontSize="15" Cursor="Hand"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NotificationCenter.Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" 
                                        CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccent}"/>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Command="{Binding ToggleNotificationsCommand}" Content="{loc:Loc shell.closeAll}" Style="{StaticResource FluentSecondaryButton}" Height="36" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- C. TOAST NOTIFICATION OVERLAY (Top-Right) -->
        <Border Grid.Row="2" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,16,20,0"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}"
                Background="#FFFFFF" BorderBrush="{StaticResource BrushAccent}" BorderThickness="2"
                CornerRadius="10" Padding="18,14" Width="360" SnapsToDevicePixels="True" Effect="{StaticResource EffectCardHoverShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔔" FontSize="20" VerticalAlignment="Top" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding ToastTitle}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccent}"/>
                    <TextBlock Text="{Binding ToastMessage}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
