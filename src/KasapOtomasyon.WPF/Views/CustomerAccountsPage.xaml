<UserControl x:Class="KasapOtomasyon.WPF.Views.CustomerAccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1400"
             Background="#F8FAFC"
             Foreground="#0F172A"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top KPI & Aging Summary Ribbon -->
            <RowDefinition Height="*"/>    <!-- Main Split View: Left List, Right Statement & Hub -->
        </Grid.RowDefinitions>

        <!-- 1. TOP KPI & AGING SUMMARY RIBBON -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                CornerRadius="14" Padding="20,14" Margin="0,0,0,18" Effect="{StaticResource EffectCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Subtitle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#4C1D95" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock Text="👥" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc customers.title}" FontSize="16" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="{loc:Loc customers.subtitle}" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Financial Aging Summary Tiles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Total Receivable -->
                    <Border Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc customers.totalReceivable}" FontSize="9.5" FontWeight="Bold" Foreground="#6D28D9"/>
                            <TextBlock Text="{Binding AgingSummary.TotalReceivable, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Black" Foreground="#4C1D95"/>
                        </StackPanel>
                    </Border>

                    <!-- Overdue Risk -->
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc customers.overdueRisk}" FontSize="9.5" FontWeight="Bold" Foreground="#B91C1C"/>
                            <TextBlock Text="{Binding AgingSummary.OverdueReceivable, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Black" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <!-- Current (0-30 Days) -->
                    <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc customers.currentAging}" FontSize="9.5" FontWeight="Bold" Foreground="#15803D"/>
                            <TextBlock Text="{Binding AgingSummary.CurrentAmount, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>
                    </Border>

                    <!-- 90+ Days Critical -->
                    <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc customers.critical90Plus}" FontSize="9.5" FontWeight="Bold" Foreground="#B45309"/>
                            <TextBlock Text="{Binding AgingSummary.Days90Plus, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MAIN SPLIT VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/> <!-- Left: Customer List & Filter -->
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="1.4*"/> <!-- Right: Master Statement & Actions -->
            </Grid.ColumnDefinitions>

            <!-- ========================================================================= -->
            <!-- LEFT COLUMN: CARI LIST, SEARCH & FILTER                                   -->
            <!-- ========================================================================= -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter Ribbon -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Status & Quick Add Expander -->
                    </Grid.RowDefinitions>

                    <!-- Search Bar & Filter Buttons -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <!-- Search Box -->
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FluentTextBox}" Height="36" Margin="0,0,0,10"
                                 FontSize="12.5"/>

                        <!-- Segment Filter Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                                    Content="{loc:Loc customers.all}" Style="{StaticResource FluentSecondaryButton}" Height="30" Margin="0,0,4,0" FontSize="11" FontWeight="Bold"/>
                            <Button Grid.Column="1" Command="{Binding SetFilterCommand}" CommandParameter="DEBTORS"
                                    Content="{loc:Loc customers.debtors}" Style="{StaticResource FluentSecondaryButton}" Height="30" Margin="2,0,2,0" FontSize="11" FontWeight="Bold"/>
                            <Button Grid.Column="2" Command="{Binding SetFilterCommand}" CommandParameter="OVERDUE"
                                    Content="{loc:Loc customers.overdue}" Style="{StaticResource FluentSecondaryButton}" Height="30" Margin="4,0,0,0" FontSize="11" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>

                    <!-- Customer DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9"
                              SelectionChanged="CustomerGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc products.code}" Binding="{Binding Code}" Width="80"/>
                            <DataGridTextColumn Header="{loc:Loc finance.customer}" Binding="{Binding Name}" Width="2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="{loc:Loc finance.phone}" Binding="{Binding PhoneNumber}" Width="1.1*"/>
                            <DataGridTextColumn Header="{loc:Loc finance.balance}" Binding="{Binding CurrentBalance, Converter={StaticResource CurrencyConv}}" Width="1.2*" FontWeight="Bold"/>
                            
                            <DataGridTemplateColumn Header="{loc:Loc common.status}" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center"
                                                Background="{Binding IsOverdue, Converter={StaticResource BoolToVis}, ConverterParameter='Red'}">
                                            <TextBlock Text="{Binding IsOverdue, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Add New Customer Accordion -->
                    <Expander Grid.Row="2" Header="+ Yeni Cari Hesap Kartı Tanımla" Margin="0,12,0,0" FontWeight="Bold" Foreground="#4C1D95">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="Müşteri / Restoran / Besici Ünvanı" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Telefon" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="VKN / TCKN" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCustomerTaxNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Kredi Limiti (₺)" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCustomerCreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Vade (Gün)" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding NewCustomerTermDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                                    </StackPanel>
                                </Grid>

                                <Button Command="{Binding CreateCustomerCommand}" 
                                        Content="✔ CARİ HESABI OLUŞTUR" 
                                        Style="{StaticResource FluentPrimaryButton}" Height="36" FontSize="12" Background="#4C1D95"/>
                            </StackPanel>
                        </Border>
                    </Expander>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- RIGHT COLUMN: MASTER STATEMENT, FINANCIAL ACTIONS & AUDIT               -->
            <!-- ========================================================================= -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Selected Customer Profile Card -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Statement Ledger DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- Selected Customer Profile Card -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SelectedCustomer.Name, TargetNullValue='Cari Hesap Seçiniz'}" 
                                               FontSize="16" FontWeight="Black" Foreground="#0F172A"/>
                                    <Border Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding SelectedCustomer.Code, TargetNullValue='-'}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedCustomer.PhoneNumber, StringFormat='Tel: {0}', TargetNullValue='Tel: -'}" 
                                           FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding SelectedCustomer.TaxNumberOrId, StringFormat='Vergi/TC No: {0}', TargetNullValue='Vergi No: -'}" 
                                           FontSize="11.5" Foreground="#64748B"/>
                            </StackPanel>

                            <!-- Balance & Risk Badge -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="GÜNCEL BAKİYE" FontSize="10" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SelectedCustomer.CurrentBalance, Converter={StaticResource CurrencyConv}}" 
                                           FontSize="20" FontWeight="Black" Foreground="#BE123C" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding SelectedCustomer.PaymentTermDays, StringFormat='Vade: {0} Gün'}" 
                                           FontSize="11" FontWeight="SemiBold" Foreground="#64748B" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action Buttons Ribbon -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 1. Quick Payment -->
                        <Button Grid.Column="0" Command="{Binding OpenPaymentModalCommand}"
                                Content="💵 Tahsilat Gir" Style="{StaticResource FluentPrimaryButton}" 
                                Background="#16A34A" Height="36" Margin="0,0,4,0" FontSize="11.5" FontWeight="Bold"/>

                        <!-- 2. Quick Debit -->
                        <Button Grid.Column="1" Command="{Binding OpenDebitModalCommand}"
                                Content="📝 Borç Dekontu" Style="{StaticResource FluentPrimaryButton}" 
                                Background="#D97706" Height="36" Margin="2,0,2,0" FontSize="11.5" FontWeight="Bold"/>

                        <!-- 3. Export PDF Statement -->
                        <Button Grid.Column="2" Command="{Binding ExportStatementPdfCommand}"
                                Content="📄 PDF Ekstre" Style="{StaticResource FluentSecondaryButton}" 
                                Height="36" Margin="2,0,2,0" FontSize="11.5" FontWeight="Bold"/>

                        <!-- 4. Send SMS Reminder -->
                        <Button Grid.Column="3" Command="{Binding SendOverdueSmsCommand}" CommandParameter="{Binding SelectedCustomer}"
                                Content="📲 SMS Gönder" Style="{StaticResource FluentSecondaryButton}" 
                                Height="36" Margin="4,0,0,0" FontSize="11.5" FontWeight="Bold"/>
                    </Grid>

                    <!-- Statement Ledger DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Transactions}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding TransactionDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="120"/>
                            <DataGridTextColumn Header="Belge No" Binding="{Binding DocumentNumber}" Width="110" FontWeight="Bold"/>
                            <DataGridTextColumn Header="İşlem Türü" Binding="{Binding TransactionType}" Width="130"/>
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Description}" Width="2*"/>
                            <DataGridTextColumn Header="Borç (₺)" Binding="{Binding Debit, Converter={StaticResource CurrencyConv}}" Width="1*" FontWeight="Bold" Foreground="#BE123C"/>
                            <DataGridTextColumn Header="Tahsilat (₺)" Binding="{Binding Credit, Converter={StaticResource CurrencyConv}}" Width="1*" FontWeight="Bold" Foreground="#16A34A"/>
                            <DataGridTextColumn Header="Son Bakiye (₺)" Binding="{Binding BalanceAfter, Converter={StaticResource CurrencyConv}}" Width="1.1*" FontWeight="Black"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL OVERLAY 1: QUICK PAYMENT (TAHSİLAT)                                -->
        <!-- ========================================================================= -->
        <Grid Grid.RowSpan="2" Background="#88000000" Visibility="{Binding IsPaymentModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" CornerRadius="14" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EffectCardShadow}">
                <StackPanel>
                    <TextBlock Text="💵 Hızlı Tahsilat Makbuzu Kaydı" FontSize="16" FontWeight="Black" Foreground="#15803D" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='Cari: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,14"/>

                    <!-- Amount -->
                    <TextBlock Text="TAHSİLAT TUTARI (₺)" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="40" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Payment Type -->
                    <TextBlock Text="ÖDEME TÜRÜ" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox SelectedValue="{Binding PaymentMethodName, Mode=TwoWay}" SelectedValuePath="Tag" Height="36" Margin="0,0,0,12">
                        <ComboBoxItem Content="💵 Nakit" Tag="Nakit" IsSelected="True"/>
                        <ComboBoxItem Content="💳 Kredi Kartı (POS)" Tag="KrediKarti"/>
                        <ComboBoxItem Content="🏦 Banka Havalesi / EFT" Tag="Havale"/>
                        <ComboBoxItem Content="📑 Çek / Senet" Tag="Cek"/>
                    </ComboBox>

                    <!-- Doc No -->
                    <TextBlock Text="MAKBUZ / EVRAK NO" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentDocNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34" Margin="0,0,0,12"/>

                    <!-- Description -->
                    <TextBlock Text="AÇIKLAMA" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PaymentDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ClosePaymentModalCommand}" Content="Vazgeç" Style="{StaticResource FluentSecondaryButton}" Height="38"/>
                        <Button Grid.Column="2" Command="{Binding SubmitPaymentCommand}" Content="✔ TAHSİLATI KAYDET" Style="{StaticResource FluentPrimaryButton}" Background="#16A34A" Height="38" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MODAL OVERLAY 2: QUICK DEBIT (BORÇ DEKONTU)                              -->
        <!-- ========================================================================= -->
        <Grid Grid.RowSpan="2" Background="#88000000" Visibility="{Binding IsDebitModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#FFFFFF" CornerRadius="14" Width="440" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource EffectCardShadow}">
                <StackPanel>
                    <TextBlock Text="📝 Toptan Sevk Borç Dekontu Ekle" FontSize="16" FontWeight="Black" Foreground="#B45309" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='Cari: {0}'}" FontSize="12.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,14"/>

                    <!-- Amount -->
                    <TextBlock Text="BORÇ TUTARI (₺)" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DebitAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="40" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Doc No -->
                    <TextBlock Text="İRSALİYE / FATURA NO" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DebitDocNo, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34" Margin="0,0,0,12"/>

                    <!-- Description -->
                    <TextBlock Text="AÇIKLAMA (SEVK EDİLEN ETLER)" Foreground="#334155" FontSize="11" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding DebitDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34" Margin="0,0,0,20"/>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding CloseDebitModalCommand}" Content="Vazgeç" Style="{StaticResource FluentSecondaryButton}" Height="38"/>
                        <Button Grid.Column="2" Command="{Binding SubmitDebitCommand}" Content="✔ BORCU KAYDET" Style="{StaticResource FluentPrimaryButton}" Background="#D97706" Height="38" FontWeight="Bold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
