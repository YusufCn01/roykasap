<UserControl x:Class="KasapOtomasyon.WPF.Views.MainMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1400"
             Background="#F8FAFC"
             Foreground="#0F172A"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:WeightFormatConverter x:Key="WeightConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Premium Modern Module Card Style -->
        <Style x:Key="HubCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" Padding="18,16"
                                Effect="{StaticResource EffectCardShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Large Colored Icon Badge -->
                                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="12" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" 
                                               FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Middle: Title & Subtitle -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource AncestorType=Button}}" 
                                               FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding ToolTip, RelativeSource={RelativeSource AncestorType=Button}}" 
                                               FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" LineHeight="16"/>
                                </StackPanel>

                                <!-- Right: Shortcut Badge -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Uid, RelativeSource={RelativeSource AncestorType=Button}}" 
                                                   FontWeight="Bold" FontSize="11" Foreground="#BE123C"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="bd" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" TargetName="bd" Value="#BE123C"/>
                                <Setter Property="Effect" TargetName="bd" Value="{StaticResource EffectCardHoverShadow}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform" TargetName="bd">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hero Featured Card for POS Satış -->
        <Style x:Key="HeroPosCardStyle" TargetType="Button">
            <Setter Property="Background" Value="#BE123C"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="130"/>
            <Setter Property="Margin" Value="6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="14" Padding="20,16"
                                Effect="{StaticResource EffectCardHoverShadow}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Glowing White Icon -->
                                <Border Grid.Column="0" Background="#33FFFFFF" CornerRadius="12" Width="58" Height="58" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="🛒" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Middle: Big Title & Desc -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Loc menu.pos.title}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <Border Background="#44FFFFFF" CornerRadius="6" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{loc:Loc menu.pos.badge}" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc menu.pos.desc}" 
                                               FontSize="11.5" Foreground="#FFE4E6" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Right: Shortcut -->
                                <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Loc menu.pos.enter}" FontWeight="Bold" FontSize="11.5" Foreground="#BE123C"/>
                                </Border>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="bd" Value="0.94"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform" TargetName="bd">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top KPI Stats Hero Ribbon -->
                <RowDefinition Height="Auto"/> <!-- Category 1: Operasyonel Modüller -->
                <RowDefinition Height="Auto"/> <!-- Category 2: Ticari & Finans -->
                <RowDefinition Height="Auto"/> <!-- Category 3: Yönetim, Kalite & Denetim -->
            </Grid.RowDefinitions>

            <!-- 1. TOP KPI STATS HERO RIBBON -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="16" Padding="22,18" Margin="0,0,0,24" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Brand Title & Active Plant -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Padding="10,4" Margin="0,0,14,0">
                            <Image Source="pack://application:,,,/Assets/roy_kasap_logo.png" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc menu.hubTitle}" FontSize="18" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="{loc:Loc shell.activePlant}" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live KPI Statistics Ribbon -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Today Ciro Tile -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc menu.kpi.todayTurnover}" FontSize="10" FontWeight="Bold" Foreground="#15803D"/>
                                <TextBlock Text="{Binding SummaryStats.TodayTurnover, Converter={StaticResource CurrencyConv}}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>

                        <!-- Slaughter Tonnage Tile -->
                        <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc menu.kpi.slaughterWeight}" FontSize="10" FontWeight="Bold" Foreground="#0369A1"/>
                                <TextBlock Text="{Binding SummaryStats.TotalCarcassWeightKg, Converter={StaticResource WeightConv}}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#0284C7"/>
                            </StackPanel>
                        </Border>

                        <!-- Yield Tile -->
                        <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="14,8" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc menu.kpi.carcassYield}" FontSize="10" FontWeight="Bold" Foreground="#B45309"/>
                                <TextBlock Text="{Binding SummaryStats.AverageCarcassYieldPercentage, StringFormat='% {0:N1}'}" 
                                           FontSize="17" FontWeight="Bold" Foreground="#D97706"/>
                            </StackPanel>
                        </Border>

                        <!-- HACCP Quality Tile -->
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="14,8">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc menu.kpi.haccpStatus}" FontSize="10" FontWeight="Bold" Foreground="#991B1B"/>
                                <TextBlock Text="{loc:Loc menu.kpi.haccpSafe}" FontSize="14" FontWeight="Bold" Foreground="#BE123C" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. SECTION 1: OPERASYONEL MEZBAHA & SATIŞ MODÜLLERİ -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                    <Border Background="#BE123C" Width="4" Height="18" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc menu.section.operations}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Featured POS Satış -->
                    <Button Grid.Column="0" Style="{StaticResource HeroPosCardStyle}"
                            Command="{Binding OpenModuleCommand}" CommandParameter="POS"/>

                    <!-- Card 2: Mezbaha & Kesimhane MES -->
                    <Button Grid.Column="1" Style="{StaticResource HubCardStyle}" Tag="🔪" Content="{loc:Loc menu.slaughter.title}"
                            ToolTip="{loc:Loc menu.slaughter.desc}"
                            Uid="[F1]" Command="{Binding OpenModuleCommand}" CommandParameter="SLAUGHTER"/>

                    <!-- Card 3: Deboning & Reçeteli Üretim BOM -->
                    <Button Grid.Column="2" Style="{StaticResource HubCardStyle}" Tag="🥩" Content="{loc:Loc menu.production.title}"
                            ToolTip="{loc:Loc menu.production.desc}"
                            Uid="[F3]" Command="{Binding OpenModuleCommand}" CommandParameter="PRODUCTION"/>

                    <!-- Card 4: Reyon SKT & Reçeteli Dönüşüm (Fire Önleme) -->
                    <Button Grid.Column="3" Style="{StaticResource HubCardStyle}" Tag="🥩" Content="{loc:Loc menu.reprocessing.title}"
                            ToolTip="{loc:Loc menu.reprocessing.desc}"
                            Uid="SKT" Command="{Binding OpenModuleCommand}" CommandParameter="REPROCESSING"/>

                    <!-- Card 5: WMS Depo & SSCC-18 Palet -->
                    <Button Grid.Column="4" Style="{StaticResource HubCardStyle}" Tag="📦" Content="{loc:Loc menu.stock.title}"
                            ToolTip="{loc:Loc menu.stock.desc}"
                            Uid="[F4]" Command="{Binding OpenModuleCommand}" CommandParameter="STOCK"/>
                </Grid>
            </StackPanel>

            <!-- 3. SECTION 2: TİCARİ, FİNANS VE MÜŞTERİ YÖNETİMİ -->
            <StackPanel Grid.Row="2" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                    <Border Background="#0284C7" Width="4" Height="18" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc menu.section.commercial}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <UniformGrid Columns="5">
                    <!-- Card 6: Ürün & Barkod Tanımları -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="🏷" Content="{loc:Loc menu.products.title}"
                            ToolTip="{loc:Loc menu.products.desc}"
                            Uid="[F5]" Command="{Binding OpenModuleCommand}" CommandParameter="PRODUCTS"/>

                    <!-- Card 7: Alım Faturaları & Müstahsil -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="📑" Content="{loc:Loc menu.invoices.title}"
                            ToolTip="{loc:Loc menu.invoices.desc}"
                            Uid="[F8]" Command="{Binding OpenModuleCommand}" CommandParameter="PURCHASE_INVOICE"/>

                    <!-- Card 8: Finans & Kasa -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="💰" Content="{loc:Loc menu.finance.title}"
                            ToolTip="{loc:Loc menu.finance.desc}"
                            Uid="[F6]" Command="{Binding OpenModuleCommand}" CommandParameter="FINANCE"/>

                    <!-- Card 9: Cari Hesaplar -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="👥" Content="{loc:Loc menu.customers.title}"
                            ToolTip="{loc:Loc menu.customers.desc}"
                            Uid="[F7]" Command="{Binding OpenModuleCommand}" CommandParameter="CUSTOMERS"/>

                    <!-- Card 10: E-Fatura & E-Arşiv -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="🏛" Content="{loc:Loc menu.einvoice.title}"
                            ToolTip="{loc:Loc menu.einvoice.desc}"
                            Uid="[F10]" Command="{Binding OpenModuleCommand}" CommandParameter="EINVOICE"/>
                </UniformGrid>
            </StackPanel>

            <!-- 4. SECTION 3: YÖNETİCİ RAPORLARI, SİSTEM & DENETİM -->
            <StackPanel Grid.Row="3">
                <StackPanel Orientation="Horizontal" Margin="4,0,0,12">
                    <Border Background="#10B981" Width="4" Height="18" CornerRadius="2" Margin="0,0,8,0"/>
                    <TextBlock Text="{loc:Loc menu.section.management}" FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>

                <UniformGrid Columns="4">
                    <!-- Card 11: Yönetici BI Raporları -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="📊" Content="{loc:Loc menu.reports.title}"
                            ToolTip="{loc:Loc menu.reports.desc}"
                            Uid="[F9]" Command="{Binding OpenModuleCommand}" CommandParameter="REPORTS"/>

                    <!-- Card 12: 18 Kurumsal Rol & Personel -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="👤" Content="{loc:Loc menu.users.title}"
                            ToolTip="{loc:Loc menu.users.desc}"
                            Uid="Güvenlik" Command="{Binding OpenModuleCommand}" CommandParameter="USERS"/>

                    <!-- Card 13: Lisans Yönetimi -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="🔑" Content="{loc:Loc menu.license.title}"
                            ToolTip="{loc:Loc menu.license.desc}"
                            Uid="Lisans" Command="{Binding OpenModuleCommand}" CommandParameter="LICENSE"/>

                    <!-- Card 14: Sistem Ayarları -->
                    <Button Style="{StaticResource HubCardStyle}" Tag="⚙" Content="{loc:Loc menu.settings.title}"
                            ToolTip="{loc:Loc menu.settings.desc}"
                            Uid="Sistem" Command="{Binding OpenModuleCommand}" CommandParameter="SETTINGS"/>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
