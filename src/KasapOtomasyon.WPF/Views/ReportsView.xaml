<UserControl x:Class="KasapOtomasyon.WPF.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1400"
             Background="#F8FAFC"
             Foreground="#0F172A"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:WeightFormatConverter x:Key="WeightConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Tab Visibility Trigger Styles -->
        <Style x:Key="TabTurnoverStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportTab}" Value="TURNOVER">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabProfitStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportTab}" Value="PROFIT">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabBreedStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportTab}" Value="BREED">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabMassBalanceStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportTab}" Value="MASS_BALANCE">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabHaccpStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedReportTab}" Value="HACCP">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,18,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Header & Excel Export Buttons -->
                <RowDefinition Height="Auto"/> <!-- 6 Executive KPI Cards -->
                <RowDefinition Height="Auto"/> <!-- Live IoT Cold Storage Telemetry -->
                <RowDefinition Height="Auto"/> <!-- Report Tab Switcher Buttons -->
                <RowDefinition Height="*"/>    <!-- Active Tab Dynamic Content -->
            </Grid.RowDefinitions>

            <!-- 1. TOP HEADER & EXCEL EXPORT BUTTONS -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="20,14" Margin="0,0,0,16" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#BE123C" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                            <TextBlock Text="📊" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc reports.title}" FontSize="16" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="{loc:Loc reports.subtitle}" FontSize="11.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="#16A34A" 
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <!-- Action Export Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ExportProductionExcelCommand}" 
                                Content="{loc:Loc reports.yieldExcel}" Style="{StaticResource FluentSecondaryButton}" 
                                Height="36" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"/>

                        <Button Command="{Binding ExportSalesExcelCommand}" 
                                Content="{loc:Loc reports.salesExcel}" Style="{StaticResource FluentSecondaryButton}" 
                                Height="36" Margin="0,0,8,0" FontSize="11" FontWeight="Bold"/>

                        <Button Command="{Binding ExportFullExecutiveExcelCommand}" 
                                Content="{loc:Loc reports.masterExcel}" Style="{StaticResource FluentPrimaryButton}" 
                                Background="#BE123C" Height="36" FontSize="11.5" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. 6 EXECUTIVE KPI CARDS -->
            <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,16">
                <!-- Card 1: Today Turnover -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="0,0,6,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc reports.kpi.turnover}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Dashboard.TodayTurnover, Converter={StaticResource CurrencyConv}}" 
                                   FontSize="18" FontWeight="Black" Foreground="#BE123C" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding Dashboard.TodaySaleCount, StringFormat='{}{0} Fiş Kesildi'}" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Total Slaughter & Carcass Weight -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="3,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc reports.kpi.tonnage}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Dashboard.TotalCarcassWeightKg, Converter={StaticResource WeightConv}}" 
                                   FontSize="18" FontWeight="Black" Foreground="#0284C7" Margin="0,4,0,2"/>
                        <TextBlock Text="{Binding Dashboard.TotalAnimalsSlaughtered, StringFormat='{}{0} Baş Kesim'}" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Mezbaha Yield Average -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="3,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc reports.kpi.yield}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Dashboard.AverageCarcassYieldPercentage, StringFormat='% {0:N1}'}" 
                                   FontSize="18" FontWeight="Black" Foreground="#D97706" Margin="0,4,0,2"/>
                        <TextBlock Text="SEUROP Standart Verim" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Mass Balance Compliance -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="3,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc reports.kpi.massBalance}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Dashboard.MassBalanceComplianceRate, StringFormat='% {0:N1}'}" 
                                   FontSize="18" FontWeight="Black" Foreground="#10B981" Margin="0,4,0,2"/>
                        <TextBlock Text="Tolerans: Δ ≤ %0.5" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 5: HACCP CCP Status -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="3,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc reports.kpi.haccp}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="✅ Tam Uyumlu" FontSize="16" FontWeight="Black" Foreground="#16A34A" Margin="0,4,0,2"/>
                        <TextBlock Text="Kritik Kontrol Noktaları" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>

                <!-- Card 6: WMS Pallets -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="12" Margin="6,0,0,0" Padding="14" Effect="{StaticResource EffectCardShadow}">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc menu.stock.title}" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding Dashboard.TotalPalletsInWms, StringFormat='{}{0} Palet'}" 
                                   FontSize="18" FontWeight="Black" Foreground="#4F46E5" Margin="0,4,0,2"/>
                        <TextBlock Text="Soğuk Depo &amp; Lojistik" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 3. LIVE IoT COLD STORAGE TELEMETRY -->
            <Border Grid.Row="2" Background="#090D16" BorderBrush="#1E293B" BorderThickness="1.5" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#131C2E" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                            <TextBlock Text="❄️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CANLI SOĞUK ZİNCİR &amp; MONORAY IoT TELEMETRİSİ" FontSize="13" FontWeight="Bold" Foreground="#38BDF8"/>
                            <TextBlock Text="Gerçek zamanlı modbus &amp; MQTT sensör izleme (Karkas Şoklama &amp; Depo Odaları)" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Sensor Gauges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢 Monoray Depo #1: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="1.8 °C (pH: 5.62)" FontWeight="Bold" FontSize="11" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢 Parçalama Salonu: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="10.4 °C (Nem: %78)" FontWeight="Bold" FontSize="11" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#131C2E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟢 Şarküteri Olgunlaşma: " FontSize="11" Foreground="#94A3B8"/>
                                <TextBlock Text="13.2 °C (Nem: %82)" FontWeight="Bold" FontSize="11" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Tüm Sensörler Normal (0 Sapma)" FontWeight="Bold" FontSize="12" Foreground="#10B981" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- 4. REPORT TAB SWITCHER BUTTONS -->
            <Border Grid.Row="3" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,0,0,16">
                <UniformGrid Columns="5">
                    <Button Command="{Binding SwitchReportTabCommand}" CommandParameter="TURNOVER"
                            Content="💵 Günlük Ciro &amp; Kasa Dağılımı" Style="{StaticResource FluentSecondaryButton}" Height="36" FontWeight="Bold" FontSize="11.5"/>
                    <Button Command="{Binding SwitchReportTabCommand}" CommandParameter="PROFIT"
                            Content="🥩 Ürün Kârlılık &amp; ABC Marjı" Style="{StaticResource FluentSecondaryButton}" Height="36" FontWeight="Bold" FontSize="11.5"/>
                    <Button Command="{Binding SwitchReportTabCommand}" CommandParameter="BREED"
                            Content="🐄 Irk &amp; SEUROP Randımanı" Style="{StaticResource FluentSecondaryButton}" Height="36" FontWeight="Bold" FontSize="11.5"/>
                    <Button Command="{Binding SwitchReportTabCommand}" CommandParameter="MASS_BALANCE"
                            Content="⚖️ Kütle Dengesi MES (Δ ≤ %0.5)" Style="{StaticResource FluentSecondaryButton}" Height="36" FontWeight="Bold" FontSize="11.5"/>
                    <Button Command="{Binding SwitchReportTabCommand}" CommandParameter="HACCP"
                            Content="🛡️ HACCP CCP Denetimi" Style="{StaticResource FluentSecondaryButton}" Height="36" FontWeight="Bold" FontSize="11.5"/>
                </UniformGrid>
            </Border>

            <!-- 5. ACTIVE TAB DYNAMIC REPORT TABLES -->
            <Grid Grid.Row="4">
                <!-- TAB 1: TURNOVER & DAILY SALES -->
                <Border Style="{StaticResource TabTurnoverStyle}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Son Günlerin Ciro, Ödeme Türü ve Brüt Kâr Dağılımı" FontSize="14" FontWeight="Black" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding TurnoverReports}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="Gün" Binding="{Binding DayName}" Width="120" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Nakit Satış" Binding="{Binding CashSales, Converter={StaticResource CurrencyConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Kredi Kartı" Binding="{Binding CardSales, Converter={StaticResource CurrencyConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Cari Satış" Binding="{Binding OnAccountSales, Converter={StaticResource CurrencyConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Toplam Ciro" Binding="{Binding TotalSales, Converter={StaticResource CurrencyConv}}" Width="1.3*" FontWeight="Bold" Foreground="#BE123C"/>
                                <DataGridTextColumn Header="Brüt Kâr" Binding="{Binding TotalProfit, Converter={StaticResource CurrencyConv}}" Width="1.3*" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="Fiş Adedi" Binding="{Binding TransactionCount, StringFormat='{}{0} Adet'}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- TAB 2: PRODUCT PROFITABILITY & MARGINS -->
                <Border Style="{StaticResource TabProfitStyle}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Ürün Bazlı Brüt Ciro, ABC Maliyet ve Kâr Marjı Dağılımı" FontSize="14" FontWeight="Black" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding ProfitabilityReports}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="1.2*"/>
                                <DataGridTextColumn Header="Satış Miktarı (Kg)" Binding="{Binding QuantitySold, StringFormat='{}{0:N2}'}" Width="1.1*"/>
                                <DataGridTextColumn Header="Brüt Ciro (₺)" Binding="{Binding Revenue, Converter={StaticResource CurrencyConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="ABC Maliyet (₺)" Binding="{Binding Cost, Converter={StaticResource CurrencyConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Brüt Kâr (₺)" Binding="{Binding GrossProfit, Converter={StaticResource CurrencyConv}}" Width="1.2*" FontWeight="Bold" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="Kâr Marjı %" Binding="{Binding ProfitMarginPercentage, StringFormat='% {0:N1}'}" Width="1*" FontWeight="Black" Foreground="#BE123C"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- TAB 3: BREED & SEUROP CARCASS YIELD -->
                <Border Style="{StaticResource TabBreedStyle}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Hayvan Irkı Bazında Canlı Ağırlık, Soğuk Karkas ve Randıman Matrisi" FontSize="14" FontWeight="Black" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding BreedReports}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Irk / Varyete" Binding="{Binding BreedName}" Width="2*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Kategori" Binding="{Binding Category}" Width="1.1*"/>
                                <DataGridTextColumn Header="Kesilen Hayvan" Binding="{Binding TotalAnimals, StringFormat='{}{0} Baş'}" Width="1.1*"/>
                                <DataGridTextColumn Header="Ort. Canlı Kg" Binding="{Binding AvgLiveWeightKg, Converter={StaticResource WeightConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Ort. Karkas Kg" Binding="{Binding AvgColdCarcassWeightKg, Converter={StaticResource WeightConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Ort. Randıman %" Binding="{Binding AvgYieldPercentage, StringFormat='% {0:N1}'}" Width="1.2*" FontWeight="Bold" Foreground="#D97706"/>
                                <DataGridTextColumn Header="En Yüksek Randıman %" Binding="{Binding BestYieldPercentage, StringFormat='% {0:N1}'}" Width="1.3*" FontWeight="Black" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="Baskın SEUROP" Binding="{Binding DominantSeuropClass}" Width="1.1*" FontWeight="Bold"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- TAB 4: DEBONING MASS BALANCE INVARIANT -->
                <Border Style="{StaticResource TabMassBalanceStyle}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Karkas Parçalama (Deboning MES) Katı Kütle Dengesi ve Adli Tolerans İzleme (Δ ≤ %0.50)" FontSize="14" FontWeight="Black" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding MassBalanceReports}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Parti No" Binding="{Binding BatchNumber}" Width="120" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Tarih" Binding="{Binding ProcessDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="100"/>
                                <DataGridTextColumn Header="Karkas Giriş (Kg)" Binding="{Binding InputCarcassWeightKg, Converter={StaticResource WeightConv}}" Width="1.3*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Asil Etler (Kg)" Binding="{Binding PrimalCutsWeightKg, Converter={StaticResource WeightConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Sakatat (Kg)" Binding="{Binding ByproductsWeightKg, Converter={StaticResource WeightConv}}" Width="1.1*"/>
                                <DataGridTextColumn Header="Kemik &amp; Yağ (Kg)" Binding="{Binding BonesAndFatWeightKg, Converter={StaticResource WeightConv}}" Width="1.2*"/>
                                <DataGridTextColumn Header="Zayiat (Kg)" Binding="{Binding WasteWeightKg, Converter={StaticResource WeightConv}}" Width="1*"/>
                                <DataGridTextColumn Header="Kütle Farkı Δ (Kg)" Binding="{Binding VarianceWeightKg, Converter={StaticResource WeightConv}}" Width="1.3*"/>
                                <DataGridTextColumn Header="Fark %" Binding="{Binding VariancePercentage, StringFormat='% {0:N2}'}" Width="1*" FontWeight="Bold"/>
                                
                                <DataGridTemplateColumn Header="Uyum Durumu" Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center"
                                                    Background="{Binding IsCompliant, Converter={StaticResource BoolToVis}, ConverterParameter='Green'}">
                                                <TextBlock Text="{Binding IsCompliant, StringFormat='{}{0}'}" FontSize="10.5" FontWeight="Bold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- TAB 5: HACCP QUALITY COMPLIANCE -->
                <Border Style="{StaticResource TabHaccpStyle}" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="HACCP CCP-1..CCP-4 Kritik Kontrol Noktaları Denetim ve Gıda Güvenliği Raporu" FontSize="14" FontWeight="Black" Margin="0,0,0,12"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding HaccpReports}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CCP No" Binding="{Binding CcpCode}" Width="100" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Kritik Kontrol Noktası" Binding="{Binding CcpName}" Width="2*" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Yasal Limit Kriteri" Binding="{Binding CriticalLimitText}" Width="2*"/>
                                <DataGridTextColumn Header="Toplam Denetim" Binding="{Binding TotalInspections, StringFormat='{}{0} Ölçüm'}" Width="1.2*"/>
                                <DataGridTextColumn Header="Sapma Sayısı" Binding="{Binding ViolationCount, StringFormat='{}{0} Adet'}" Width="1.1*" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Uyum Oranı %" Binding="{Binding ComplianceRatePercentage, StringFormat='% {0:N1}'}" Width="1.2*" FontWeight="Black" Foreground="#16A34A"/>
                                <DataGridTextColumn Header="Güvenlik Durumu" Binding="{Binding StatusText}" Width="1.5*" FontWeight="Bold" Foreground="#0284C7"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
