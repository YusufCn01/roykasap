<UserControl x:Class="KasapOtomasyon.WPF.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="{StaticResource BrushBackground}"
             Foreground="{StaticResource BrushTextPrimary}">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:WeightFormatConverter x:Key="WeightConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Warehouse Filter & Traceability Search -->
        <Border Grid.Row="0" Style="{StaticResource FluentCard}" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc wms.warehouse}" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                              DisplayMemberPath="Name" Width="220" Height="34"
                              SelectionChanged="WarehouseComboBox_SelectionChanged"/>
                </StackPanel>

                <!-- Traceability / Lot Search Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔍 Geriye Dönük İzlenebilirlik (Parti/Lot No):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Text="{Binding TraceabilitySearch, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Width="160" Height="34" Margin="0,0,8,0"/>
                    <Button Command="{Binding SearchTraceabilityCommand}" Content="{loc:Loc common.search}" Style="{StaticResource FluentSecondaryButton}" Padding="12,6" Margin="0,0,16,0"/>
                    
                    <Button Command="{Binding OpenPalletBuilderModalCommand}" 
                            Content="{loc:Loc menu.stock.title}" 
                            Style="{StaticResource FluentPrimaryButton}" Height="34" Padding="14,0" FontWeight="Bold" Background="#0284C7"/>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" 
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Middle: Inventory Table & Critical Alert Cards -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Inventory Grid -->
            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Depo Stok Bakiyeleri ve Parti Bilgileri" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Inventory}" Style="{StaticResource FluentDataGrid}" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kod" Binding="{Binding ProductCode}" Width="90"/>
                            <DataGridTextColumn Header="Ürün Adı" Binding="{Binding ProductName}" Width="2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Kategori" Binding="{Binding CategoryName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Depo" Binding="{Binding WarehouseName}" Width="1.2*"/>
                            <DataGridTextColumn Header="Mevcut Stok (Kg)" Binding="{Binding CurrentQuantity, StringFormat='{}{0:0.00}'}" Width="1.1*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Parti / Lot" Binding="{Binding LotNumber}" Width="1.2*"/>
                            <DataGridTextColumn Header="Son Kullanma (SKT)" Binding="{Binding ExpiryDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="1.2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Critical Expiry & Low Stock Alerts -->
            <StackPanel Grid.Column="2">
                <!-- Critical SKT Box -->
                <Border Style="{StaticResource FluentCard}" BorderBrush="#EF4444" BorderThickness="1.5" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⏰ " FontSize="16"/>
                            <TextBlock Text="Kritik SKT / Taze Et Uyarıları" FontSize="14" FontWeight="Bold" Foreground="#F87171"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding ExpiryAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2B1518" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                                <TextBlock Text="{Binding LotNumber, StringFormat='Parti: {0}'}" FontSize="10" Foreground="#FDA4AF"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding ExpiryDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
                                                       FontWeight="Bold" FontSize="11" Foreground="#EF4444" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Command="{Binding OpenReprocessingCommand}" 
                                Content="🔄 Reyon SKT Kurtarma &amp; Dönüştür" 
                                Style="{StaticResource FluentPrimaryButton}" Height="34" FontSize="11" FontWeight="Bold" Background="#B45309" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Low Stock Alert Box -->
                <Border Style="{StaticResource FluentCard}" BorderBrush="#F59E0B" BorderThickness="1.5" Padding="16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠️ " FontSize="16"/>
                            <TextBlock Text="Kritik Minimum Stok Uyarıları" FontSize="14" FontWeight="Bold" Foreground="#FBBF24"/>
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding CriticalAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#241B0E" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentQuantity, StringFormat='{}{0:0.0} kg Kaldı'}" 
                                                       FontWeight="Bold" FontSize="11" Foreground="#F59E0B" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Bottom: Inter-Warehouse Transfer Tool -->
        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="16,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Depolar Arası Transfer:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kaynak:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferSource}" DisplayMemberPath="Name" Width="160" Height="32" Margin="0,0,12,0"/>

                    <TextBlock Text="Hedef:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedItem="{Binding TransferDest}" DisplayMemberPath="Name" Width="160" Height="32" Margin="0,0,12,0"/>

                    <TextBlock Text="Ürün:" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding Inventory}" SelectedItem="{Binding TransferProduct}" DisplayMemberPath="ProductName" Width="180" Height="32" Margin="0,0,12,0"/>

                    <TextBlock Text="Miktar (Kg):" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding TransferQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Width="70" Height="32"/>
                </StackPanel>

                <Button Grid.Column="2" Command="{Binding ExecuteTransferCommand}" 
                        Content="Transferi Onayla" Style="{StaticResource FluentPrimaryButton}" Padding="16,6" Height="34"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- DIALOG: WMS SSCC-18 LOJİSTİK PALET YÖNETİMİ                              -->
        <!-- ========================================================================= -->
        <Grid Grid.RowSpan="3" Background="#60000000" Visibility="{Binding IsPalletBuilderModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="950" MaxHeight="800" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#FFFFFF" BorderBrush="{StaticResource BrushBorder}" BorderThickness="2"
                    CornerRadius="16" Padding="26" Effect="{StaticResource EffectModalShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0284C7" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                                <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WMS SSCC-18 PALETLEME &amp; LOJİSTİK YÖNETİMİ" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock Text="GS1-128 Standart 18 Haneli Seri Sevkiyat Konteyner Kodu &amp; Depo Raf Yönetimi" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Button HorizontalAlignment="Right" Command="{Binding ClosePalletBuilderModalCommand}" 
                                Content="✕" Background="Transparent" Foreground="{StaticResource BrushTextSecondary}" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                    </Grid>

                    <!-- Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Pallet Builder Form -->
                            <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1.5" CornerRadius="10" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Product & Lot -->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="PALETLENECEK ET MAMULÜ" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletProductName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="PARTİ / LOT NUMARASI" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletLotNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="KOLİ SAYISI" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletBoxCount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Row 1: Net Weight, Bin & Customer -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,0,0">
                                        <TextBlock Text="SEVK EDİLECEK MÜŞTERİ / ŞUBE" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletCustomer, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                        <TextBlock Text="DEPO RAF/GÖZ ADRESİ" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletWarehouseBin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                        <TextBlock Text="TOPLAM NET KG" FontSize="11" FontWeight="Bold" Foreground="#0369A1"/>
                                        <TextBox Text="{Binding NewPalletNetWeightKg, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="36" FontWeight="Bold" Foreground="#0284C7" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Active Pallets Table -->
                            <TextBlock Text="WMS AKTİF PALET STOKLARI VE SEVKİYAT DURUMU" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>
                            <Border Background="#F8FAFC" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="0">
                                <DataGrid ItemsSource="{Binding ActivePallets}" Style="{StaticResource FluentDataGrid}" BorderThickness="0" MaxHeight="240">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Palet No" Binding="{Binding PalletNumber}" FontWeight="Bold" Width="1.2*"/>
                                        <DataGridTextColumn Header="SSCC-18 Barkod" Binding="{Binding Sscc18Barcode}" FontFamily="Consolas" FontWeight="Bold" Width="2*"/>
                                        <DataGridTextColumn Header="Koli" Binding="{Binding TotalBoxesCount}" Width="0.8*"/>
                                        <DataGridTextColumn Header="Net (Kg)" Binding="{Binding TotalNetWeightKg, Converter={StaticResource WeightConv}}" FontWeight="Bold" Width="1*"/>
                                        <DataGridTextColumn Header="Brüt (Kg)" Binding="{Binding TotalGrossWeightKg, Converter={StaticResource WeightConv}}" Width="1*"/>
                                        <DataGridTextColumn Header="Depo Rafı" Binding="{Binding TargetWarehouseBin}" Width="1*"/>
                                        <DataGridCheckBoxColumn Header="Karantina" Binding="{Binding IsQuarantined}" Width="0.8*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Action Buttons -->
                    <Grid Grid.Row="2">
                        <Button HorizontalAlignment="Left" Command="{Binding ClosePalletBuilderModalCommand}" Content="Kapat" Style="{StaticResource FluentSecondaryButton}" Height="42" Padding="20,0"/>
                        <Button HorizontalAlignment="Right" Command="{Binding BuildPalletSSCCCommand}" 
                                Content="✓ YENİ SSCC-18 PALET OLUŞTUR VE ETİKET BAS" Style="{StaticResource FluentPrimaryButton}" Height="42" Padding="24,0" FontWeight="Bold" Background="#0284C7"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
