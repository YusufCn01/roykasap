<UserControl x:Class="KasapOtomasyon.WPF.Views.PurchaseInvoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1400"
             Background="#F8FAFC"
             Foreground="#0F172A"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:WeightFormatConverter x:Key="WeightConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>

        <!-- Tab Visibility Trigger Styles -->
        <Style x:Key="TabListStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveTab}" Value="LIST">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabCreateStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActiveTab}" Value="CREATE">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top KPI & Summary Header -->
            <RowDefinition Height="Auto"/> <!-- Tab Selector Ribbon -->
            <RowDefinition Height="*"/>    <!-- Dynamic Tab Content -->
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. TOP HEADER & FINANCIAL PROCUREMENT KPIS                                 -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                CornerRadius="14" Padding="20,14" Margin="0,0,0,16" Effect="{StaticResource EffectCardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#BE123C" CornerRadius="10" Width="46" Height="46" Margin="0,0,12,0">
                        <TextBlock Text="📑" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc invoices.title}" FontSize="16" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="{loc:Loc invoices.subtitle}" FontSize="11.5" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- KPI Tiles -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Monthly Purchase Volume -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc invoices.monthlyVolume}" FontSize="9.5" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding KpiSummary.MonthlyPurchaseAmount, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Black" Foreground="#BE123C"/>
                        </StackPanel>
                    </Border>

                    <!-- Purchase Weight -->
                    <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc invoices.monthlyTonnage}" FontSize="9.5" FontWeight="Bold" Foreground="#0369A1"/>
                            <TextBlock Text="{Binding KpiSummary.MonthlyPurchaseWeightKg, Converter={StaticResource WeightConv}}" 
                                       FontSize="15" FontWeight="Black" Foreground="#0284C7"/>
                        </StackPanel>
                    </Border>

                    <!-- Tevkifat Deducted -->
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc invoices.tevkifat}" FontSize="9.5" FontWeight="Bold" Foreground="#92400E"/>
                            <TextBlock Text="{Binding KpiSummary.TotalTevkifatDeducted, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Bold" Foreground="#D97706"/>
                        </StackPanel>
                    </Border>

                    <!-- Pending Payables -->
                    <Border Background="#FDF2F8" BorderBrush="#FBCFE8" BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc invoices.pendingPayables}" FontSize="9.5" FontWeight="Bold" Foreground="#9D174D"/>
                            <TextBlock Text="{Binding KpiSummary.PendingSupplierPayables, Converter={StaticResource CurrencyConv}}" 
                                       FontSize="15" FontWeight="Black" Foreground="#DB2777"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. TAB SELECTOR RIBBON                                                    -->
        <!-- ========================================================================= -->
        <Border Grid.Row="1" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" 
                CornerRadius="10" Padding="4" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Command="{Binding SwitchTabCommand}" CommandParameter="LIST"
                        Content="{loc:Loc invoices.tabList}" Style="{StaticResource FluentSecondaryButton}" 
                        Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Margin="0,0,6,0"/>

                <Button Grid.Column="1" Command="{Binding SwitchTabCommand}" CommandParameter="CREATE"
                        Content="{loc:Loc invoices.tabCreate}" Style="{StaticResource FluentPrimaryButton}" 
                        Background="#BE123C" Height="36" Padding="18,0" FontWeight="Bold" FontSize="12"/>

                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="#16A34A" FontWeight="Bold" 
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>

                <Button Grid.Column="3" Command="{Binding ExportExcelCommand}"
                        Content="📥 Excel (.xlsx)" Style="{StaticResource FluentSecondaryButton}" 
                        Height="36" Padding="14,0" FontWeight="Bold" FontSize="11.5"/>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 3. DYNAMIC TAB 1: INVOICE LIST & ARCHIVE                                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Style="{StaticResource TabListStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/> <!-- Left: Invoices Table -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.1*"/> <!-- Right: Selected Invoice Details -->
            </Grid.ColumnDefinitions>

            <!-- Left: Invoices Table -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search & Filter -->
                        <RowDefinition Height="*"/>    <!-- DataGrid -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource FluentTextBox}" Height="36" FontSize="12.5"/>

                        <!-- Type Filters -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Command="{Binding SetFilterTypeCommand}" CommandParameter="ALL"
                                    Content="Tümü" Style="{StaticResource FluentSecondaryButton}" Height="36" Padding="12,0" Margin="0,0,4,0" FontSize="11" FontWeight="Bold"/>
                            <Button Command="{Binding SetFilterTypeCommand}" CommandParameter="TICARI"
                                    Content="🥩 Ticari KDV'li" Style="{StaticResource FluentSecondaryButton}" Height="36" Padding="12,0" Margin="0,0,4,0" FontSize="11" FontWeight="Bold"/>
                            <Button Command="{Binding SetFilterTypeCommand}" CommandParameter="MUSTAHSIL"
                                    Content="🌾 Müstahsil" Style="{StaticResource FluentSecondaryButton}" Height="36" Padding="12,0" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                              Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fatura No" Binding="{Binding InvoiceNumber}" Width="120" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="95"/>
                            <DataGridTextColumn Header="Tedarikçi / Besici" Binding="{Binding SupplierName}" Width="2*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding InvoiceTypeDisplay}" Width="1.2*"/>
                            <DataGridTextColumn Header="Toplam Kg" Binding="{Binding TotalQuantityKg, Converter={StaticResource WeightConv}}" Width="1*"/>
                            <DataGridTextColumn Header="Net Tutar (₺)" Binding="{Binding GrandTotal, Converter={StaticResource CurrencyConv}}" Width="1.2*" FontWeight="Black" Foreground="#BE123C"/>
                            <DataGridTextColumn Header="Ödeme Durumu" Binding="{Binding PaymentStatusDisplay}" Width="1.1*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Selected Invoice Details & Actions -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Invoice Header Card -->
                        <RowDefinition Height="Auto"/> <!-- Actions Ribbon -->
                        <RowDefinition Height="*"/>    <!-- Lines Table -->
                    </Grid.RowDefinitions>

                    <!-- Invoice Header Card -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedInvoice.SupplierName, TargetNullValue='Fatura Seçiniz'}" 
                                               FontSize="15" FontWeight="Black" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber, StringFormat='Belge No: {0}'}" 
                                               FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding SelectedInvoice.InvoiceTypeDisplay, StringFormat='Fatura Türü: {0}'}" 
                                               FontSize="11" FontWeight="Bold" Foreground="#BE123C"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="ÖDENECEK NET" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SelectedInvoice.GrandTotal, Converter={StaticResource CurrencyConv}}" 
                                               FontSize="18" FontWeight="Black" Foreground="#BE123C" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding ExportPdfCommand}" CommandParameter="{Binding SelectedInvoice}"
                                Content="📄 Resmi Fatura / Müstahsil PDF" Style="{StaticResource FluentPrimaryButton}" 
                                Background="#16A34A" Height="36" FontWeight="Bold" FontSize="11"/>
                        <Button Grid.Column="2" Command="{Binding CancelInvoiceCommand}" CommandParameter="{Binding SelectedInvoice}"
                                Content="❌ Faturayı İptal Et" Style="{StaticResource FluentSecondaryButton}" 
                                Foreground="#DC2626" Height="36" FontWeight="Bold" FontSize="11"/>
                    </Grid>

                    <!-- Invoice Lines DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedInvoice.Lines}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ürün / Malzeme" Binding="{Binding ItemName}" Width="2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Miktar" Binding="{Binding Quantity, Converter={StaticResource WeightConv}}" Width="1*"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConv}}" Width="1.1*"/>
                            <DataGridTextColumn Header="KDV %" Binding="{Binding VatRate, StringFormat='% {0:N0}'}" Width="70"/>
                            <DataGridTextColumn Header="Tutar" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConv}}" Width="1.1*" FontWeight="Bold"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 4. DYNAMIC TAB 2: CREATE NEW PURCHASE INVOICE / MÜSTAHSİL                   -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Style="{StaticResource TabCreateStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.6*"/> <!-- Left: Header & Lines Editor -->
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1.0*"/> <!-- Right: Financial Summary & Actions -->
            </Grid.ColumnDefinitions>

            <!-- Left: Header & Lines Editor -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Invoice Header Form -->
                        <RowDefinition Height="Auto"/> <!-- Add Line Item Form -->
                        <RowDefinition Height="*"/>    <!-- Lines DataGrid -->
                    </Grid.RowDefinitions>

                    <!-- 1. INVOICE HEADER FORM -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Supplier, Type, Invoice No, Waybill No -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Tedarikçi Firma / Besici Çiftçi" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="Name" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Fatura / Belge Türü" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <ComboBox SelectedValue="{Binding NewInvoiceType, Mode=TwoWay}" SelectedValuePath="Tag" Height="34">
                                    <ComboBoxItem Content="🥩 Ticari Alım (KDV'li)" Tag="TicariAlimFaturasi" IsSelected="True"/>
                                    <ComboBoxItem Content="🌾 Müstahsil Makbuzu" Tag="MustahsilMakbuzu"/>
                                    <ComboBoxItem Content="🚚 İrsaliyeli Alım" Tag="IrsaliyeliAlim"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Fatura No / E-Belge No" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewInvoiceNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="6">
                                <TextBlock Text="Sevk İrsaliyesi No" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding NewWaybillNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="34"/>
                            </StackPanel>

                            <!-- Row 2: Date, Due Date, Auto Stock Checkbox -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Fatura / Düzenleme Tarihi" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding NewInvoiceDate}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Vade Tarihi" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                                <DatePicker SelectedDate="{Binding NewDueDate}" Height="34"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding NewAutoStock}" Content="Ürünleri ve Karkasları Otomatik Depo Stoklarına Giriş Yap" FontWeight="Bold" FontSize="11.5" Foreground="#15803D"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 2. ADD LINE ITEM BAR -->
                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" 
                            CornerRadius="10" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Product Selector, Item Name, Quantity, UnitPrice, Vat, Add Button -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Tanımlı Ürün / Karkas" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="Name" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Kalem Açıklaması" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LineItemName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Miktar (Kg / Adet)" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="6">
                                <TextBlock Text="Birim Fiyat" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LineUnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="8">
                                <TextBlock Text="KDV %" Foreground="#64748B" FontSize="11" Margin="0,0,0,3"/>
                                <TextBox Text="{Binding LineVatRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="32"/>
                            </StackPanel>

                            <Button Grid.Row="0" Grid.Column="10" Command="{Binding AddLineCommand}"
                                    Content="+ KALEMİ EKLE" Style="{StaticResource FluentPrimaryButton}" 
                                    Background="#16A34A" Height="32" Padding="14,0" FontWeight="Bold" FontSize="11"/>

                            <!-- Row 2: Lot Number, Ear Tag Number, Storage Location -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Parti / Lot No" Foreground="#64748B" FontSize="10.5" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding LineLotNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Hayvan Küpe No (Varsa)" Foreground="#64748B" FontSize="10.5" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding LineEarTagNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="28"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="5">
                                <TextBlock Text="Depo &amp; Askı Ray Yeri" Foreground="#64748B" FontSize="10.5" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding LineStorageLocation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="28"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. LINES DATAGRID -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding NewInvoiceLines}" Style="{StaticResource FluentDataGrid}" BorderThickness="1" BorderBrush="#F1F5F9">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kalem Adı" Binding="{Binding ItemName}" Width="2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Parti / Küpe" Binding="{Binding LotNumber}" Width="1.2*"/>
                            <DataGridTextColumn Header="Miktar (Kg)" Binding="{Binding Quantity, StringFormat='{}{0:N2}'}" Width="1*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Birim Fiyat" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyConv}}" Width="1.1*"/>
                            <DataGridTextColumn Header="KDV %" Binding="{Binding VatRate, StringFormat='% {0:N0}'}" Width="70"/>
                            <DataGridTextColumn Header="Depo Yeri" Binding="{Binding StorageLocation}" Width="1.3*"/>

                            <DataGridTemplateColumn Header="İşlem" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="🗑 Sil" Foreground="#DC2626" Background="Transparent" BorderThickness="0" Cursor="Hand" FontWeight="Bold" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Right: Financial Summary & Actions -->
            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1.5" 
                    CornerRadius="14" Padding="18" Effect="{StaticResource EffectCardShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Calculation Breakdown -->
                        <RowDefinition Height="Auto"/> <!-- Save / Clear Buttons -->
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Mali Hesap ve Vergi Dökümü" FontSize="15" FontWeight="Black" Foreground="#0F172A" Margin="0,0,0,14"/>

                    <!-- Calculation Breakdown -->
                    <StackPanel Grid.Row="1">
                        <!-- Subtotal -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Brüt Matrah / Ara Toplam:" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveSubTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Discount -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="İskonto Toplamı:" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveDiscountTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" Foreground="#16A34A" HorizontalAlignment="Right"/>
                        </Grid>

                        <Separator Margin="0,4,0,8" Background="#E2E8F0"/>

                        <!-- VAT -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Hesaplanan KDV (%1 / %10 / %20):" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveVatTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" Foreground="#BE123C" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Tevkifat -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Et Alım Tevkifatı (9/10):" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveTevkifatTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" Foreground="#D97706" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Withholding (Müstahsil) -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="GV Müstahsil Stopajı (%1):" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveWithholdingTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" Foreground="#DC2626" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- SGK & Borsa -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="SGK Bağ-Kur &amp; Borsa Tescil:" Foreground="#475569" FontSize="12.5"/>
                            <TextBlock Text="{Binding LiveSgkTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="13" Foreground="#64748B" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Grand Total Card -->
                        <Border Background="#FFF1F2" BorderBrush="#FECDD3" BorderThickness="1.5" CornerRadius="10" Padding="14" Margin="0,10,0,14">
                            <StackPanel>
                                <TextBlock Text="NET ÖDENECEK / CARİ BORÇ" FontSize="10.5" FontWeight="Bold" Foreground="#9F1239"/>
                                <TextBlock Text="{Binding LiveGrandTotal, Converter={StaticResource CurrencyConv}}" 
                                           FontSize="22" FontWeight="Black" Foreground="#BE123C" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Notes Box -->
                        <TextBlock Text="Fatura Notları &amp; Açıklama" Foreground="#475569" FontSize="11" FontWeight="Bold" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Save / Clear Buttons -->
                    <StackPanel Grid.Row="2">
                        <Button Command="{Binding SaveInvoiceCommand}" 
                                Content="💾 FATURAYI KAYDET &amp; STOKLARA İŞLE" 
                                Style="{StaticResource FluentPrimaryButton}" 
                                Background="#BE123C" Height="42" FontSize="13" FontWeight="Black" Margin="0,0,0,8"/>

                        <Button Command="{Binding ResetNewInvoiceFormCommand}" 
                                Content="❌ Formu Temizle" 
                                Style="{StaticResource FluentSecondaryButton}" 
                                Height="34" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
