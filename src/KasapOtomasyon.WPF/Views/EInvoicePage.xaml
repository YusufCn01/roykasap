<UserControl x:Class="KasapOtomasyon.WPF.Views.EInvoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:KasapOtomasyon.WPF.Converters"
             xmlns:loc="clr-namespace:KasapOtomasyon.WPF.Markup"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             Background="{StaticResource BrushBgMain}"
             Foreground="{StaticResource BrushTextPrimary}"
             FontFamily="Segoe UI Variable, Segoe UI, Inter, sans-serif">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyConv"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.4*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: E-Invoice List -->
        <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📑 " FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc einvoice.title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource BrushSuccess}" 
                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Invoices}" SelectedItem="{Binding SelectedInvoice}"
                          Style="{StaticResource FluentDataGrid}" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc products.code}" Binding="{Binding InvoiceNumber}" Width="130" FontWeight="Bold"/>
                        <DataGridTextColumn Header="{loc:Loc common.date}" Binding="{Binding InvoiceDate, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc products.type}" Binding="{Binding InvoiceType}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc common.total}" Binding="{Binding GrandTotal, Converter={StaticResource CurrencyConv}}" Width="1.1*" FontWeight="Bold"/>
                        <DataGridTextColumn Header="{loc:Loc common.status}" Binding="{Binding EInvoiceStatus}" Width="110"/>

                        <!-- GİB Send Button -->
                        <DataGridTemplateColumn Header="{loc:Loc finance.action}" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:Loc einvoice.sendGib}" Style="{StaticResource FluentPrimaryButton}" 
                                            Padding="6,3" FontSize="11"
                                            Command="{Binding DataContext.SendToGibCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- RIGHT: Invoice Preview & XML / Details -->
        <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{loc:Loc einvoice.detailsTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="Fatura No:" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber}" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="ETTN / UUID:" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.Uuid}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushTextMuted}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="GİB Durumu:" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.EInvoiceStatus}" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="GİB Kod / Açıklama:" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.GibStatusDescription}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,8,0,12"/>

                    <TextBlock Text="{loc:Loc einvoice.itemsTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding SelectedInvoice.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgSurface}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="12"/>
                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:0.00} kg/adet'}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Total, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{StaticResource BrushBorder}" Margin="0,8,0,12"/>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc pos.subtotal}" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.SubTotal, Converter={StaticResource CurrencyConv}}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{loc:Loc einvoice.vatAmount}" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding SelectedInvoice.VatTotal, Converter={StaticResource CurrencyConv}}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{loc:Loc pos.grandTotal}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="{Binding SelectedInvoice.GrandTotal, Converter={StaticResource CurrencyConv}}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource BrushAccentLight}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Button Command="{Binding SendToGibCommand}" CommandParameter="{Binding SelectedInvoice}"
                            Content="{loc:Loc einvoice.sendSelectedBtn}" Style="{StaticResource FluentPrimaryButton}" Height="42" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
